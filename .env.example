# Mức độ ghi log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG

# -----------------------------------------------------------------------------
# CẤU HÌNH DATABASE NGUỒN: SQL Server (OLTP)
# -----------------------------------------------------------------------------
# Driver ODBC: 'ODBC Driver 17 for SQL Server' hoặc 'ODBC Driver 18 for SQL Server'
SRC_DB_DRIVER=
# Địa chỉ máy chủ: hostname hoặc IP (ví dụ: localhost, 127.0.0.1, hoặc localhost\SQLEXPRESS)
SRC_DB_SERVER=
# Cổng kết nối: 1433 (để trống nếu dùng Named Instance như localhost\SQLEXPRESS)
SRC_DB_PORT=
SRC_DB_NAME=
# Xác thực Windows: 'yes' (Windows Auth) hoặc 'no' (SQL Server Auth dùng User/Pass)
SRC_DB_TRUSTED_CONNECTION=
SRC_DB_TRUST_SERVER_CERTIFICATE=
SRC_DB_USER=
SRC_DB_PASSWORD=

# -----------------------------------------------------------------------------
# CẤU HÌNH DATABASE ĐÍCH: PostgreSQL Data Warehouse (Staging)
# -----------------------------------------------------------------------------
TGT_DB_HOST=
TGT_DB_PORT=
TGT_DB_NAME=
TGT_DB_USER=
TGT_DB_PASSWORD=
TGT_DB_SCHEMA=

# -----------------------------------------------------------------------------
# CẤU HÌNH VẬN HÀNH & CẢNH BÁO (TÙY CHỌN)
# -----------------------------------------------------------------------------
# Số luồng trích xuất và nạp song song tầng Bronze (mặc định: 4)
ETL_MAX_WORKERS=
# Múi giờ lưu dữ liệu DATETIME trên nguồn SQL Server (vd: UTC hoặc Asia/Ho_Chi_Minh)
SRC_DB_TIMEZONE=
# Webhook URL (Slack / Discord / Telegram) để nhận cảnh báo khi pipeline lỗi
ALERT_WEBHOOK_URL=
# Bật/tắt gửi webhook từ script Python (tắt khi chạy qua Airflow để tránh trùng cảnh báo)
ALERT_ON_SCRIPT_ERROR=

# -----------------------------------------------------------------------------
# CẤU HÌNH APACHE AIRFLOW ORCHESTRATOR (CHẠY QUA DOCKER COMPOSE)
# -----------------------------------------------------------------------------
AIRFLOW_UID=
AIRFLOW_PORT=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
